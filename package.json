{
  "name": "argot-cli",
  "version": "0.4.0-dev.1",
  "description": "A command-line argument parser with a simple configuration format",
  "type": "module",
  "scripts": {
    "pretest": "npm run buildTest",
    "test": "node --test --enable-source-maps",
    "coverage": "npm run buildTest && node --experimental-test-coverage --test",
    "build": "tsc && esbuild --minify --outdir=dist --packages=external --platform=node --allow-overwrite ./dist/**/*.js",
    "buildTest": "esbuild --outdir=test --packages=external --platform=node --sourcemap __tests__/**/*.ts",
    "clean": "rm -rf ./dist/",
    "prepare": "npm run clean && npm run build",
    "prepack": "mv README.md github.md && cp npm.md README.md",
    "postpack": "mv github.md README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llucasls/argot-ts.git"
  },
  "license": "ISC",
  "keywords": [],
  "bugs": {
    "url": "https://github.com/llucasls/argot-ts/issues"
  },
  "homepage": "https://github.com/llucasls/argot-ts#readme",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "expect": "^30.5.2",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    ".": "./dist/mod.js"
  },
  "types": "./dist/mod.d.ts",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
